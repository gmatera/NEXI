<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.cbi.chc.ccr</groupId>
		<artifactId>chc-ccr-hub</artifactId>
		<version>1.5.0-SNAPSHOT</version>
	</parent>
	<artifactId>chc-ccr-dashboard-event-simulator</artifactId>

	<properties>
		<spring-cloud.version>2021.0.3</spring-cloud.version>
	</properties>


	<dependencies>
		<dependency>
			<groupId>com.cbi.chc.framework</groupId>
			<artifactId>chc-framework-micros</artifactId>
			<version>${chc-framework-version}</version>
		</dependency>
		<dependency>
			<groupId>com.cbi.chc.framework</groupId>
			<artifactId>chc-framework-rabbitmq</artifactId>
			<version>${chc-framework-version}</version>
		</dependency>

		<dependency>
			<groupId>com.cbi.chc.ccr</groupId>
			<artifactId>chc-ccr-dto</artifactId>
			<version>${project.version}</version>
		</dependency>
		
		<!-- per attivare Spring cloud e far funzionare il config server.
		senza queste non riesce a scaricare lo yml dal config server-->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-config</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>

	</dependencies>

<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	
	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>version</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<!-- Package as an executable jar/ -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
